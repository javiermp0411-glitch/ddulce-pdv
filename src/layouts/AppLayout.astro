---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daylú Dulce | Punto de venta',
  description = 'Punto de venta de Daylú Dulce.',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fff5f6" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="64x64" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
